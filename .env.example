# 默认使用 DeepSeek。密钥只放在本机 .env，不要写入飞书或提交到代码仓库。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：切换回 OpenAI 时使用。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# 一般无需修改。Windows 下使用飞书 CLI 的实际安装入口。
LARK_CLI_ENTRY=C:\Users\jayomaxel\AppData\Roaming\npm\node_modules\@larksuite\cli\scripts\run.js
AGENT_CONFIG=./config/agent.config.json
